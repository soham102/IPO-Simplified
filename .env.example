# ---------------------------------------------------------------------------
# IPO Simplified - environment variables
# Copy to .env.local and fill in only what you need. Every variable is optional:
# with none set, the app shows the curated real-IPO dataset with
# deterministic (non-AI) explanations. Set DATA_PROVIDER=mock for the demo dataset.
# ---------------------------------------------------------------------------

# Data source: "curated" (default: real IPOs compiled from public sources),
# "mock" (fictional sample companies) or "supabase".
DATA_PROVIDER=curated

# Supabase (only needed when DATA_PROVIDER=supabase, or to store error reports).
# Server-side only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI explanation layer (server-side only). Leave blank to disable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

